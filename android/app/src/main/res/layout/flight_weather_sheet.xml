<?xml version="1.0" encoding="utf-8"?>
<!-- Maps&Fly: the weather page of a takeoff in a window over the map. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_half"
    android:paddingEnd="@dimen/margin_half">

    <!-- The page shows the name, height and directions of the site itself. -->
    <ImageButton
      android:id="@+id/flight_weather_info"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="?selectableItemBackgroundBorderless"
      android:contentDescription="@string/flight_weather_site_info"
      android:src="@drawable/ic_info_outline"
      android:tint="?android:textColorSecondary" />

    <Space
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <ImageButton
      android:id="@+id/flight_weather_close"
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="?selectableItemBackgroundBorderless"
      android:contentDescription="@string/close"
      android:src="@drawable/ic_close_themed" />
  </LinearLayout>

  <TextView
    android:id="@+id/flight_weather_offline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margin_base"
    android:paddingEnd="@dimen/margin_base"
    android:paddingBottom="@dimen/margin_quarter"
    android:textAppearance="@style/MwmTextAppearance.Body3"
    android:visibility="gone" />

  <WebView
    android:id="@+id/flight_weather_web"
    android:layout_width="match_parent"
    android:layout_height="0dp" />
</LinearLayout>
