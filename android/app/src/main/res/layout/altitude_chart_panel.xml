<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/altitude_chart_panel"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginTop="@dimen/margin_quarter_plus"
  android:layout_weight="1"
  android:orientation="vertical"
  android:paddingBottom="@dimen/margin_half_plus"
  tools:showIn="@layout/routing_bottom_sheet">

  <LinearLayout
    android:paddingStart="@dimen/routing_plan_horizontal_padding"
    android:paddingEnd="@dimen/routing_plan_horizontal_padding"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
      android:orientation="vertical"
      android:layout_weight="1"
      android:layout_width="0dp"
      android:layout_height="wrap_content">

      <TextView
        android:id="@+id/time_vehicle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        tools:text="5 h 55 min • 1555km"
        tools:visibility="visible"
        android:layout_marginTop="@dimen/margin_half"
        android:visibility="gone" />

      <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/time_elevation_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_half"
        android:layout_marginBottom="@dimen/margin_half">

        <androidx.constraintlayout.helper.widget.Flow
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:constraint_referenced_ids="time,altitude_difference"
          app:flow_horizontalBias="0"
          app:flow_horizontalGap="@dimen/margin_half"
          app:flow_horizontalStyle="packed"
          app:flow_verticalAlign="baseline"
          app:flow_verticalGap="@dimen/margin_quarter"
          app:flow_wrapMode="chain"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent" />

        <TextView
          android:id="@+id/time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="2"
          tools:text="5 h 55 min • 1555km"
          tools:visibility="visible" />

        <TextView
          android:id="@+id/altitude_difference"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@string/robotoMedium"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?colorAccent"
          android:visibility="gone"
          tools:text="↗ 43 m ↘ 88 m"
          tools:visibility="visible" />
      </androidx.constraintlayout.widget.ConstraintLayout>

      <!-- Maps&Fly: SAC path grades of the route as a bar; the info button shows the lengths. -->
      <LinearLayout
        android:id="@+id/route_grade_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_half"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <app.organicmaps.routing.StackedBarView
          android:id="@+id/route_grade_bar"
          android:layout_width="0dp"
          android:layout_height="10dp"
          android:layout_weight="1" />

        <TextView
          android:id="@+id/route_grade_max"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/margin_half"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          tools:text="max. T3" />

        <ImageView
          android:id="@+id/route_grade_info"
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:layout_marginStart="@dimen/margin_quarter"
          android:contentDescription="@string/route_path_grades"
          android:padding="4dp"
          app:srcCompat="@drawable/ic_route_info"
          app:tint="?iconTint" />
      </LinearLayout>

      <TextView
        android:id="@+id/route_grade_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_half"
        android:textAppearance="@style/MwmTextAppearance.Body3"
        android:visibility="gone"
        tools:text="■ bis T2 8,2 km   ■ T3 1,1 km   ■ T4–T6 0,3 km"
        tools:visibility="visible" />

      <!-- Maps&Fly: warning when the route uses an avoided SAC grade, e.g. because of a stop. -->
      <TextView
        android:id="@+id/route_path_grades"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margin_half"
        android:textAppearance="@style/MwmTextAppearance.Body3"
        android:textColor="@color/base_red"
        android:visibility="gone"
        tools:text="Die Route führt über T3-Wege, die du meidest."
        tools:visibility="visible" />

      <TextView
        android:id="@+id/time_ruler"
        style="@style/MwmWidget.TextView.PlanDetail.Number.Time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="40 min"
        android:layout_marginTop="@dimen/margin_half"
        android:visibility="gone"
        tools:visibility="visible" />

    </LinearLayout>

    <ImageView
      android:id="@+id/reverse_route_btn"
      android:layout_width="@dimen/margin_double"
      android:layout_height="@dimen/margin_double"
      android:layout_marginStart="@dimen/margin_half"
      android:layout_marginEnd="@dimen/margin_half"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/reverse_route"
      app:srcCompat="@drawable/ic_swap_vert"
      app:tint="?iconTint" />

    <FrameLayout
      android:id="@+id/driving_options_btn_container"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content">

      <ImageView
        android:id="@+id/driving_options_btn_img"
        android:layout_width="@dimen/margin_double"
        android:layout_height="@dimen/margin_double"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:srcCompat="@drawable/ic_menu_settings"
        app:tint="?iconTint" />

      <!-- Layer 2: The Badge (on top of the icon) -->
      <TextView
        android:id="@+id/driving_options_badge"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="top|end"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="2"
        tools:visibility="visible" />
    </FrameLayout>
  </LinearLayout>

  <!-- Transit summary tile (see @layout/transit_summary_tile). Full-width and self-contained. -->
  <include
    layout="@layout/transit_summary_tile"
    android:id="@+id/transit_time"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/altitude_chart_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <include
      layout="@layout/route_elevation_profile"
      android:id="@+id/altitude_chart"
      android:layout_width="match_parent"
      android:layout_height="@dimen/route_chart_height"
      android:visibility="gone" />

  </LinearLayout>

</LinearLayout>
