<?xml version="1.0" encoding="utf-8"?>
<!-- Maps&Fly: settings of one map layer, opened with a long press in the layers menu. Small and
     at the bottom, so the map stays visible while the sliders move. -->
<com.google.android.material.card.MaterialCardView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:layout_marginHorizontal="@dimen/margin_base"
  android:layout_marginBottom="@dimen/margin_half"
  app:cardBackgroundColor="?attr/cardBackground"
  app:cardCornerRadius="@dimen/margin_half"
  app:cardElevation="4dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_half_plus"
    android:paddingBottom="@dimen/margin_half">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <TextView
        android:id="@+id/layer_settings_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/MwmTextAppearance.Body2"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        tools:text="Gelände" />
      <ImageButton
        android:id="@+id/layer_settings_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:src="@drawable/ic_close"
        app:tint="?iconTint" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/layer_settings_radar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">
      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/radar_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
          android:id="@+id/radar_source_dwd"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="DWD" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/radar_source_rainviewer"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="RainViewer" />
      </com.google.android.material.button.MaterialButtonToggleGroup>
      <TextView
        android:id="@+id/radar_source_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/MwmTextAppearance.Body4"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="Deutschland, 2 h zurück und 2 h Vorhersage" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_quarter"
        android:orientation="horizontal">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/layer_opacity"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorPrimary" />
        <TextView
          android:id="@+id/radar_opacity_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorSecondary" />
      </LinearLayout>
      <com.google.android.material.slider.Slider
        android:id="@+id/radar_opacity"
        style="@style/MwmWidget.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:valueFrom="10"
        android:valueTo="100"
        app:labelBehavior="gone" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/layer_settings_satellite"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">
      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/satellite_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
          android:id="@+id/satellite_source_esri"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Esri" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/satellite_source_sentinel"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="Sentinel-2" />
      </com.google.android.material.button.MaterialButtonToggleGroup>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_quarter"
        android:orientation="horizontal">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/pref_bg_tiles_opacity_title"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorPrimary" />
        <TextView
          android:id="@+id/satellite_area_opacity_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorSecondary" />
      </LinearLayout>
      <com.google.android.material.slider.Slider
        android:id="@+id/satellite_area_opacity"
        style="@style/MwmWidget.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:valueFrom="0"
        android:valueTo="100"
        app:labelBehavior="gone" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/layer_settings_terrain"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:visibility="gone">
      <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/terrain_contour_lines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/contour_lines_title"
        android:textAppearance="@style/MwmTextAppearance.Body3" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_quarter"
        android:orientation="horizontal">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/hillshade_strength_title"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorPrimary" />
        <TextView
          android:id="@+id/terrain_strength_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorSecondary" />
      </LinearLayout>
      <com.google.android.material.slider.Slider
        android:id="@+id/terrain_strength"
        style="@style/MwmWidget.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="10"
        android:valueFrom="0"
        android:valueTo="300"
        app:labelBehavior="gone" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_quarter"
        android:orientation="horizontal">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/hillshade_light_title"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorPrimary" />
        <TextView
          android:id="@+id/terrain_light_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorSecondary" />
      </LinearLayout>
      <com.google.android.material.slider.Slider
        android:id="@+id/terrain_light"
        style="@style/MwmWidget.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1"
        android:valueFrom="0"
        android:valueTo="7"
        app:labelBehavior="gone" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_quarter"
        android:orientation="horizontal">
        <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/hillshade_altitude_title"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorPrimary" />
        <TextView
          android:id="@+id/terrain_altitude_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textAppearance="@style/MwmTextAppearance.Body3"
          android:textColor="?android:attr/textColorSecondary" />
      </LinearLayout>
      <com.google.android.material.slider.Slider
        android:id="@+id/terrain_altitude"
        style="@style/MwmWidget.Slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="5"
        android:valueFrom="10"
        android:valueTo="80"
        app:labelBehavior="gone" />
    </LinearLayout>
  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
